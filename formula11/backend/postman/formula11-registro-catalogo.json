{
  "info": {
    "name": "Formula11 - Registro y catalogo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{"key": "baseUrl", "value": "http://localhost:8080"}, {"key": "token", "value": ""}, {"key": "jugadorId", "value": "1"}],
  "item": [
    {
      "name": "Registrar usuario",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\"nombre\":\"Ana\",\"email\":\"ana@example.com\",\"password\":\"Secreto123!\"}"},
        "url": {"raw": "{{baseUrl}}/api/usuarios/registro", "host": ["{{baseUrl}}"], "path": ["api", "usuarios", "registro"]}
      }
    },
    {
      "name": "Iniciar sesión",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();",
              "if (response.token) pm.collectionVariables.set('token', response.token);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\"email\":\"ana@example.com\",\"password\":\"Secreto123!\"}"},
        "url": {"raw": "{{baseUrl}}/api/usuarios/login", "host": ["{{baseUrl}}"], "path": ["api", "usuarios", "login"]}
      }
    },
    {
      "name": "Consultar jugadores",
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
        "url": {"raw": "{{baseUrl}}/api/jugadores", "host": ["{{baseUrl}}", "api", "jugadores"]}
      }
    },
    {
      "name": "Comprar tokens",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Authorization", "value": "Bearer {{token}}"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {"mode": "raw", "raw": "{\"jugadorId\":1,\"cantidad\":2}"},
        "url": {"raw": "{{baseUrl}}/api/ordenes/compra", "host": ["{{baseUrl}}"], "path": ["api", "ordenes", "compra"]}
      }
    },
    {
      "name": "Vender tokens",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Authorization", "value": "Bearer {{token}}"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {"mode": "raw", "raw": "{\"jugadorId\":1,\"cantidad\":1}"},
        "url": {"raw": "{{baseUrl}}/api/ordenes/venta", "host": ["{{baseUrl}}", "api", "ordenes", "venta"], "path": ["api", "ordenes", "venta"]}
      }
    },
    {"name": "Detalle de jugador", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}], "url": {"raw": "{{baseUrl}}/api/jugadores/{{jugadorId}}", "host": ["{{baseUrl}}"], "path": ["api", "jugadores", "{{jugadorId}}"]}}},
    {"name": "Ranking de jugadores", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}], "url": {"raw": "{{baseUrl}}/api/jugadores/ranking?liga=La Liga&posicion=DEL&page=0&size=20", "host": ["{{baseUrl}}"], "path": ["api", "jugadores", "ranking"], "query": [{"key": "liga", "value": "La Liga"}, {"key": "posicion", "value": "DEL"}, {"key": "page", "value": "0"}, {"key": "size", "value": "20"}]}}},
    {"name": "Historial de cotizaciones", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}], "url": {"raw": "{{baseUrl}}/api/jugadores/{{jugadorId}}/cotizaciones?desde=2026-08-01&hasta=2026-10-31", "host": ["{{baseUrl}}"], "path": ["api", "jugadores", "{{jugadorId}}", "cotizaciones"], "query": [{"key": "desde", "value": "2026-08-01"}, {"key": "hasta", "value": "2026-10-31"}]}}},
    {"name": "Cotizacion a una fecha", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}], "url": {"raw": "{{baseUrl}}/api/jugadores/{{jugadorId}}/cotizaciones/vigente?fecha=2026-09-17", "host": ["{{baseUrl}}"], "path": ["api", "jugadores", "{{jugadorId}}", "cotizaciones", "vigente"], "query": [{"key": "fecha", "value": "2026-09-17"}]}}},
    {"name": "Senales vigentes", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}], "url": {"raw": "{{baseUrl}}/api/senales?vigentes=true&page=0&size=20", "host": ["{{baseUrl}}"], "path": ["api", "senales"], "query": [{"key": "vigentes", "value": "true"}, {"key": "page", "value": "0"}, {"key": "size", "value": "20"}]}}},
    {"name": "Panel de aciertos", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}], "url": {"raw": "{{baseUrl}}/api/senales/aciertos", "host": ["{{baseUrl}}"], "path": ["api", "senales", "aciertos"]}}}
  ]
}
